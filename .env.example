# Supabase (server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: prepend to raw API keys before SHA-256 (use same value when inserting key_hash)
API_KEY_HASH_PEPPER=

# Email (Resend HTTP API — no extra npm package required)
# RESEND_API_KEY=re_...
# EMAIL_FROM="Social Proof <no-reply@yourdomain.com>"

# API key delivery for POST /api/request-api-key
# - email: sends key via Resend (requires RESEND_API_KEY + EMAIL_FROM)
# - inline: returns the raw key in the JSON response (dev-only; do not use in production)
# API_KEY_DELIVERY=email

# App base URL (for Stripe redirect + links in emails)
# APP_URL=http://localhost:3000

# Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...

# Local dev: path to Chrome/Chromium if @sparticuz/chromium bundle fails on your OS
# CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Brand bar on screenshots (optional)
# BRAND_BAR_TEXT=Your Brand
# BRAND_BAR_SUBTEXT=screenshot

# Deploy: set the same env vars in Vercel. Screenshot routes need Node runtime (already set in route.ts).
# On Vercel Hobby, max serverless time may be shorter than maxDuration in code — upgrade or simplify captures if you hit timeouts.
